# ==============================================
# EduTrack Attendance Management System Environment
# ==============================================

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# Database Configuration (MongoDB Atlas or Local MongoDB)
# If empty or not running, the API automatically boots mongodb-memory-server in development
MONGODB_URI=mongodb://localhost:27017/school_attendance

# Authentication & Security
JWT_ACCESS_SECRET=your-super-secret-access-token-key-change-in-production-123456
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-in-production-789012
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Push Notifications (Firebase Cloud Messaging)
# Leave blank for built-in Dev Mock Logger
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Email Provider Configuration (SMTP / Mock)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EduTrack Attendance <noreply@edutrack.school>"

# Frontend Web Application
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Mobile Application
EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1
