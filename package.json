{
  "name": "school-attendance-system",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise-grade School Attendance Management System",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev:api": "npm run dev --workspace=@school/api",
    "dev:web": "npm run dev --workspace=@school/web",
    "dev:mobile": "npm run start --workspace=@school/mobile",
    "seed": "npm run seed --workspace=@school/api"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.4.5"
  }
}
